# Canonical origin for metadata, sitemap, robots and structured data.
# Recommended: https://harshith.qyverix.in (see README).
NEXT_PUBLIC_SITE_URL=https://harshith.qyverix.in

# Search engine ownership tokens (content="..." value of the meta tag each
# console offers). Leave empty until you have them.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
